# Copy to .env (never commit .env). All values below are examples.

# PostgreSQL (local docker example; Railway injects DATABASE_URL automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/warehouse
# Integration tests use a separate database (created once: CREATE DATABASE warehouse_test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/warehouse_test

PORT=3001

# Agent mode: auto (LLM if key set, else deterministic) | llm | deterministic
AGENT_MODE=auto

# Any OpenAI-compatible chat-completions endpoint with function calling.
# Default: Google Gemini (free key from https://aistudio.google.com/apikey)
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT_MS=30000
# Space LLM requests (ms) to stay under free-tier requests-per-minute limits; 0 disables
LLM_MIN_INTERVAL_MS=4000
